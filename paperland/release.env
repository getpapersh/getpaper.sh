# Pinned release values. build.sh inlines this file into the built install,
# so every value must be a bare word: no quotes, spaces, $ or backticks.

# Omarchy plugin repo; its default branch is the generated `release` branch.
PLUGIN_URL=https://github.com/getpapersh/paperland.git
# Commit the installer accepts as the plugin's HEAD. PENDING refuses to install.
PLUGIN_SHA=52db6d6306328976cc18bb56d2c50a80268db11a
MIN_HYPRLAND=0.56

