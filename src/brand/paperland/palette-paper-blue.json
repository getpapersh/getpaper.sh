{
  "$description": "Paper brand color tokens - direction 'Paper & Fold Blue' (recommended, Nov 9 2026). Approved 2026-11-09.",
  "meta": {
    "name": "paper-blue",
    "version": "0.1.0-draft",
    "source": "Paper brand colour review (approved by Jason 2026-11-09)",
    "rules": [
      "One accent for every selected/focused thing on every surface.",
      "Text in accent color always uses accentText, never accent.",
      "Selected tiles: solid accent fill + onAccent label; keep a 0.75px white 16% inner rim on dark for extra margin.",
      "Anything drawn straight on a wallpaper (focused-window border) uses a two-tone ring: focus color + 1px dark outline #0B1220 at 60%.",
      "Orange #E2470F is retired from UI; if kept at all it is a marketing-only marker, never a state."
    ]
  },
